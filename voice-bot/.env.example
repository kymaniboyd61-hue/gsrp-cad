# Copy this file, name the copy ".env", and fill in every line. Never share the .env file.

# Discord Developer Portal > your application > Bot > Reset Token
DISCORD_TOKEN=

# Right-click your server > Copy Server ID (Developer Mode must be on)
GUILD_ID=

# Right-click the RTO voice channel > Copy Channel ID
VOICE_CHANNEL_ID=

# Your CAD link, with no slash at the end
CAD_URL=https://gsrp-cad.kymaniboyd61.workers.dev

# CAD > Admin > Discord > Create bot key
CAD_BOT_KEY=

# Free key from console.groq.com > API Keys
GROQ_API_KEY=

# The word that wakes the dispatcher
WAKE_WORD=dispatch

# Only change these if Groq renames or removes a model
STT_MODEL=whisper-large-v3-turbo
CHAT_MODEL=openai/gpt-oss-120b
